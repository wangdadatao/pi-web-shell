# pi-web-shell configuration. Copy to .env and adjust as needed.

# HTTP bind address. Keep 127.0.0.1 unless you know what you are doing.
PI_SHELL_HOST=127.0.0.1

# HTTP port. Use 0 to let the OS pick a free port.
PI_SHELL_PORT=4711

# Where pi stores sessions. Defaults to ~/.pi/agent/sessions.
# Leave this commented out when you want the default: pi then groups sessions per
# project (<dir>/--<encoded-cwd>--/), which is what `pi --resume` lists. Setting a
# custom path makes pi store them flat in that directory instead, and the CLI will
# only see them if you pass the same --session-dir there.
# PI_SHELL_SESSIONS_DIR=/Users/you/.pi/agent/sessions

# The pi executable to spawn in RPC mode. Defaults to "pi" on PATH.
PI_SHELL_PI_BIN=pi

# Open the browser automatically on startup.
PI_SHELL_OPEN_BROWSER=1

# Shut down an idle pi subprocess after this many milliseconds.
PI_SHELL_IDLE_TIMEOUT_MS=900000
